# Face Tracking System Environment Configuration
# Copy this file to .env and modify the settings as needed

# System Configuration
TEAM_ID=Joyeuse01
SYSTEM_PHASE=phase1

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=Joyeuse01
MQTT_PASSWORD=user

# WebSocket Configuration
WEBSOCKET_PORT=9002
WEBSOCKET_HOST=0.0.0.0

# Vision Node Configuration
CAMERA_ID=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
DETECTION_CONFIDENCE=0.5
TRACKING_CONFIDENCE=0.5
CENTER_THRESHOLD=0.15
PUBLISH_INTERVAL=0.1

# Logging Configuration
LOG_LEVEL=INFO
